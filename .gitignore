# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environment ----
.venv/
venv/
env/

# ---- Test / tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Generated experiment data ----
# These are re-creatable with `python -m src.generate`, so they are not
# committed. The folders themselves are kept via .gitkeep.
data/*.parquet
data/*.meta.json
groundtruth/*.json
results/*.csv
results/*.json

# ...except the frozen demo run, which IS committed so the dashboard's
# replay mode always works with nothing connected.
!data/demo_*.parquet
!data/demo_*.meta.json
!groundtruth/demo_*.json
!results/demo_*.json

# ...and the headline results table, which IS the project's finding and
# should be readable in the repository without re-running anything.
!results/table1.csv
!results/per_run.csv
