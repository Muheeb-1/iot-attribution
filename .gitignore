# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environment ----
.venv/
venv/
env/

# ---- Test / tooling caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- Editors / OS ----
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# ---- Generated experiment data ----
# These are re-creatable with `python -m src.generate`, so they are not
# committed. The folders themselves are kept via .gitkeep.
data/*.parquet
data/*.meta.json
groundtruth/*.json
results/*.csv
results/*.json

# ...except the frozen demo run, which IS committed so the dashboard's
# replay mode always works with nothing connected.
!data/demo_*.parquet
!data/demo_*.meta.json
!groundtruth/demo_*.json
!results/demo_*.json

# ...and the headline results tables, which ARE the project's finding and
# should be readable in the repository without re-running anything. The
# per-run files are named after the summary table they belong to, so each
# summary needs its own exception line beside it.
!results/table1.csv
!results/table1_per_run.csv

# The live set is the same finding measured against the real lab rather than
# the simulator, so it is committed on the same reasoning. Its ground truth
# comes too: without the answer files the live table cannot be re-scored or
# checked by anyone reading the repository, and unlike the simulated sets
# there is no generator that can recreate them - the runs happened once.
!results/table_live.csv
!results/table_live_per_run.csv
!results/live_batch_manifest.json
!groundtruth/live_batch_*.json

# ---- Live lab captures ----
# Raw packet captures are large binaries (baseline.pcapng alone is ~5 MB) and
# are re-creatable by re-running the lab, so they stay out of git. The
# firmware that produced them IS tracked - it is source, and it is small.
pcap/

# ---- Secrets ----
# The Gemini API key lives here. Never commit it.
API_KEY.env
*.env
